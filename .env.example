# ============================================================
# КОРНЕВОЙ .env — используется docker-compose.yml для подстановки ${VAR}.
# Копировать: cp .env.example .env   (файл .env в git не попадает)
# ============================================================

# --- Общие настройки ---
TZ=Europe/Moscow

# --- PostgreSQL (БД для n8n и pgvector) ---
POSTGRES_USER=change_me_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vectordb
POSTGRES_PORT=5432
POSTGRES_BIND_IP=127.0.0.1

# --- PostgreSQL App (БД для микросервисов OCR Platform) ---
APP_DB_USER=app_user
APP_DB_PASSWORD=change_me_app_password
APP_DB_NAME=appdb
APP_DB_PORT=5433
APP_DB_BIND_IP=127.0.0.1

# --- JWT (OCR Platform) ---
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256

# --- OCR Platform: Scheduler Service ---
OCR_SCHEDULER_PORT=8001
OCR_SCHEDULER_BIND_IP=127.0.0.1

# --- OCR Platform: OCR Worker ---
OCR_WORKER_POLL_INTERVAL_SEC=5
OCR_WORKER_BATCH_SIZE=10
OCR_SCHEDULER_REQUEST_TIMEOUT_SEC=15

# --- N8N интеграция ---
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=change_me_n8n_api_key
N8N_REQUEST_TIMEOUT_SEC=30

# --- Ollama (GPU, эмбеддинги) ---
OLLAMA_PORT=11435
OLLAMA_BIND_IP=127.0.0.1

# --- n8n ---
N8N_PORT=5678
N8N_BIND_IP=0.0.0.0
N8N_EDITOR_BASE_URL=http://192.168.0.5:5678/
N8N_WEBHOOK_URL=http://n8n:5678/
N8N_WEBHOOK_MODE=test

# --- MCP Server ---
MCP_PORT=9000
MCP_BIND_IP=127.0.0.1
MCP_WORKSPACE=/workspace
MCP_HOST=0.0.0.0
MCP_LOG_LEVEL=INFO
MCP_MAX_WORKERS=10
MCP_MAX_OUTPUT_CHARS=100000
MCP_COMMAND_TIMEOUT_SECONDS=60
MCP_MAX_COMMAND_TIMEOUT_SECONDS=600
MCP_SEARCH_MAX_MATCHES=200
MCP_EXEC_DEFAULT_WORKDIR=/app
MCP_SESSION_IDLE_TIMEOUT=300
MCP_MAX_SESSIONS=10
MCP_DNS_REBINDING_PROTECTION=false

# --- Docker ---
DOCKER_SOCKET_PATH=/var/run/docker.sock
