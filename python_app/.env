# Copy to `.env` and adjust values.

# REQUIRED: secret used to verify JWT tokens (HS* algorithms)
JWT_SECRET=DqjYCpgrf9pMJER9mNzC0st3kWPQ2f2Cei8q2IUq5u60MvCGwnkD-fQ7wEF36JCB

# JWT signing algorithm
JWT_ALGORITHM=HS256

# REQUIRED: n8n OCR webhook URL
# ВАЖНО: n8n работает по HTTP (N8N_PROTOCOL=http в docker-compose), не HTTPS!
# /webhook-test/... — это URL "пробного" запуска из редактора n8n: он активен только
# пока в редакторе нажата кнопка "Listen for test event". Для продакшена используйте
# сохранённый и активированный вебхук: /webhook/ocr
OCR_API_URL=http://192.168.0.5:5678/webhook/ocr

# OCR API request timeout, seconds
OCR_API_TIMEOUT=120

# Maximum decoded file size, megabytes
MAX_FILE_SIZE_MB=50