# ── Приложение ──
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO

# ── База данных (PostgreSQL) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ocr_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── n8n вебхуки ──
N8N_BASE_URL=http://localhost:5678
N8N_OCR_WEBHOOK_PATH=/webhook/ocr
N8N_CREATE_DOC_WEBHOOK_PATH=/webhook/create_document
N8N_REQUEST_TIMEOUT_SEC=30

# ── Воркер ──
WORKER_POLL_INTERVAL_SEC=5
WORKER_MAX_RETRIES=3
