# ---------- Postgres ----------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=database

N8N_EDITOR_BASE_URL=http://localhost:9000/
N8N_WEBHOOK_URL=http://n8n_dev:9000/
TZ=Europe/Moscow

UID=1000
GID=1000

# ---------- Restic backup ----------
# Examples:
# Local: RESTIC_REPOSITORY=/backup-target
# S3:    RESTIC_REPOSITORY=s3:s3.amazonaws.com/bucket-name/path
# REST:  RESTIC_REPOSITORY=rest:https://user:pass@host:port/repo
RESTIC_REPOSITORY=
RESTIC_PASSWORD=change-this-password-in-production
BACKUP_CRON_SCHEDULE=0 2 * * *
RESTIC_FORGET_PRUNE_ARGS=--keep-daily 7 --keep-weekly 4 --keep-monthly 3

# ---------- ocr_service ----------
OCR_LOG_LEVEL=INFO
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- Ollama ----------
OLLAMA_EMBEDDING_MODEL=hf.co/unsloth/embeddinggemma-2-GGUF:UD-Q6_K_XL

# ---------- n8n (общее) ----------
N8N_TOKEN=

# ---------- ELMA365 ----------
ELMA_TOKEN=
ELMA_BASE_URL=
ELMA_LIST_PATH=
ELMA_REQUEST_TIMEOUT_SEC=30

# ---------- worker_service ----------
WORKER_LOG_LEVEL=INFO
N8N_BASE_URL=http://n8n_dev:9000
N8N_REQUEST_TIMEOUT_SEC=30
WORKER_POLL_INTERVAL_SEC=5
WORKER_MAX_RETRIES=3