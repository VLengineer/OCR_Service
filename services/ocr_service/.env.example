# ── Приложение ──
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── База данных (PostgreSQL) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ocr_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── JWT авторизация ──
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── n8n вебхуки ──
N8N_BASE_URL=http://localhost:5678
N8N_OCR_WEBHOOK_PATH=/webhook/ocr
N8N_CREATE_DOC_WEBHOOK_PATH=/webhook/create_elma_document
N8N_RECOGNIZE_WEBHOOK_PATH=/webhook/recognize_document
N8N_REQUEST_TIMEOUT_SEC=30

# ── Обработка документов ──
MAX_SHEETS_PER_TASK=50

# ── Ollama Embeddings ──
OLLAMA_HOST=ollama
OLLAMA_PORT=11435
OLLAMA_EMBEDDING_MODEL=hf.co/unsloth/embeddinggemma-2-GGUF:UD-Q6_K_XL

# ── Chunking ──
CHUNK_SIZE=500
CHUNK_OVERLAP=50
